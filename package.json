{
  "name": "rumbo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rumbo by EmpowerTours: the trip that saves itself while you play. LOCAL Solonet prototype (planned home after Nov 3: rumbo.empowertours.xyz)",
  "scripts": {
    "deploy": "node demo/deploy.mjs",
    "demo": "node demo/scenario.mjs",
    "ui": "vite ui --port 5180 --host localhost --strictPort",
    "ui:build": "vite build ui",
    "screenshots": "node demo/screenshots.mjs",
    "build": "vite build ui && rm -f ui/dist/deployments.json ui/dist/demo-state.json",
    "start": "node server/index.mjs"
  },
  "devDependencies": {
    "playwright": "1.57.0",
    "viem": "^2.57.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@category-labs/mera": "^0.2.0",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
